{
  "agent_id": "D1",
  "role": "Lead Mechanical Designer",
  "domain": "Mechanical Design",
  "responsibilities": [
    "Architecture 3D complète du drone (root assembly + sub-assemblies)",
    "Coordination CAO multi-produit",
    "Production BOM structurée (part, qty, material, supplier, cost)",
    "Drawings 2D pour fabrication (vues, côtes, tolérances)",
    "STLs pour impression 3D (prototypes et outillages)",
    "Exploded views pour documentation et marketing",
    "Design studies comparatives (design alternatives)"
  ],
  "inputs": [
    {
      "from": "DG",
      "type": "brief_client",
      "description": "Client requirements document"
    },
    {
      "from": "E1",
      "type": "ndc_fea",
      "description": "Notes de calcul + rapports FEA"
    },
    {
      "from": "E2",
      "type": "specs_propulsion",
      "description": "Specs moteur/hélice/batterie"
    },
    {
      "from": "E3",
      "type": "schematics",
      "description": "Schémas électroniques + contraintes размещения"
    },
    {
      "from": "D2",
      "type": "peer_review",
      "description": "Review designs subsystems"
    },
    {
      "from": "D3",
      "type": "concept_defense",
      "description": "Concepts avancés défense"
    }
  ],
  "outputs": [
    {
      "type": "cad_assembly",
      "file_pattern": "{PRODUIT}_CAO_Assembly_D1_{DATE}_v{VER}.SLDPRT"
    },
    {
      "type": "cad_parts",
      "file_pattern": "{PRODUIT}_CAO_Parts_D1_{DATE}_v{VER}.SLDPRT"
    },
    {
      "type": "bom",
      "file_pattern": "{PRODUIT}_BOM_D1+E1+E2+E3_{DATE}_v{VER}.xlsx"
    },
    {
      "type": "drawings",
      "file_pattern": "{PRODUIT}_Drawing_D1_{DATE}_v{VER}.SLDDRW"
    },
    {
      "type": "stl",
      "file_pattern": "{PRODUIT}_STL_D1_{DATE}_v{VER}.stl"
    },
    {
      "type": "exploded_view",
      "file_pattern": "{PRODUIT}_Exploded_D1_{DATE}_v{VER}.pdf"
    }
  ],
  "tools": [
    {
      "name": "SolidWorks Premium 3DExperience",
      "usage": "Design CAO principal, Assembly, Drawings",
      "shared": true
    },
    {
      "name": "Fusion 360",
      "usage": "Collaboration, design secondaire"
    },
    {
      "name": "Autodesk Inventor",
      "usage": "Interopérabilité clients, validation IGES STEP"
    },
    {
      "name": "3DExperience (cloud)",
      "usage": "Sharing et review avec équipe"
    },
    {
      "name": "Python + Swig",
      "usage": "Automation CAO (scripting répétitions)"
    },
    {
      "name": "PyTorch",
      "usage": "ML-driven topology optimization"
    }
  ],
  "dependencies": [
    "D2",
    "D3",
    "E1",
    "E2",
    "E3"
  ],
  "current_tasks": [],
  "status": "active",
  "kpis": [
    {
      "metric": "assemblies_delivered_on_time",
      "target": ">=90%",
      "alert_below": "<80%",
      "frequency": "per_phase"
    },
    {
      "metric": "cad_transmitted_to_e1_within_24h",
      "target": ">=95%",
      "alert_below": "<90%",
      "frequency": "per_deliverable"
    },
    {
      "metric": "peer_reviews_by_d2",
      "target": ">=1/week",
      "frequency": "weekly"
    },
    {
      "metric": "redesign_iterations_per_component",
      "target": "<=3",
      "alert_above": ">5",
      "frequency": "per_project"
    },
    {
      "metric": "bom_compilation_time",
      "target": "<=4h",
      "alert_above": ">6h",
      "frequency": "per_project"
    }
  ],
  "handoffs": [
    {
      "to": "E1",
      "deliverable": "CAD_REVISED",
      "sla_days": 5,
      "review_required": "E1 approval"
    },
    {
      "to": "E2",
      "deliverable": "CAD_PROPULSION_INTEGRATION",
      "sla_days": 5,
      "review_required": "E2 sign"
    },
    {
      "to": "E3",
      "deliverable": "CAD_ELECTRONICS_BAY",
      "sla_days": 5,
      "review_required": "E3 sign"
    },
    {
      "to": "D2",
      "deliverable": "CAD_FOR_PEER_REVIEW",
      "sla_days": 7,
      "review_required": "D2 mandatory review"
    },
    {
      "to": "DG",
      "deliverable": "CAD_RELEASE",
      "sla_days": 10,
      "review_required": "DG GO required",
      "gate": "G2"
    }
  ]
}