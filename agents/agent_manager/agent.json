{
  "agent_id": "agent_manager",
  "role": "Agent Manager",
  "domain": "Coordination",
  "responsibilities": [
    "Coordination quotidienne de tous les agents (D1-D3, E1-E3)",
    "Gestion des KPIs et alertes (dashboard ops-alerts)",
    "Orchestration des débriefs collectifs (fin de chaque phase)",
    "Gestion des handoffs entre agents",
    "Escalade technique vers DG",
    "Gestion des blocages et problèmes résolution",
    "Pipeline européen et specs armasuisse",
    "Planification stratégique et weekly syncs"
  ],
  "inputs": [
    {
      "from": "all_agents",
      "type": "kpi_reports",
      "description": "Rapports KPI quotidiens"
    },
    {
      "from": "all_agents",
      "type": "blocker_flags",
      "description": "Alertes blockers via #problem-escalation"
    },
    {
      "from": "DG",
      "type": "go_no_go_decisions",
      "description": "Décisions DG aux gates"
    },
    {
      "from": "all_agents",
      "type": "peer_review_results",
      "description": "Résultats peer reviews"
    }
  ],
  "outputs": [
    {
      "type": "daily_digest",
      "file_pattern": "DAILY_DIGEST_{DATE}.md"
    },
    {
      "type": "decision_log",
      "file_pattern": "DECISION_LOG.json"
    },
    {
      "type": "kpi_dashboard",
      "file_pattern": "KPI_DASHBOARD_{DATE}.json"
    },
    {
      "type": "go_no_go_package",
      "file_pattern": "GATE_{N}_PACKAGE_{DATE}.zip"
    },
    {
      "type": "weekly_sync_notes",
      "file_pattern": "WEEKLY_SYNC_{DATE}.md"
    }
  ],
  "tools": [
    {
      "name": "Slack",
