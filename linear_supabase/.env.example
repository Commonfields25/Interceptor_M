# ===========================================
# Interceptor_M - Linear + Supabase Integration
# Configuration Environment Variables
# ===========================================

# ===== SUPABASE =====
# URL du projet Supabase ( Settings > API > Project URL )
SUPABASE_URL=https://xxxxx.supabase.co

# Clé publique (anon key) - pour les lectures
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Clé de service (service key) - pour les écritures admin
SUPABASE_SERVICE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# ===== LINEAR =====
# Clé API Linear ( Settings > API > Create Key )
LINEAR_API_KEY=lin_api_xxxxxxxxxxxxxxxx

# ID de l'équipe Linear (trouvable dans les paramètres de l'équipe)
LINEAR_TEAM_ID=INTERCEPTOR-TEAM

# ID du workspace Linear
LINEAR_WORKSPACE_ID=INTERCEPTOR-M-WORKSPACE

# ===== GITHUB =====
# Token GitHub avec permissions repo
# ( Settings > Developer settings > Personal access tokens )
GITHUB_TOKEN=ghp_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Propriétaire du repo (par défaut: Commonfields25)
GITHUB_OWNER=Commonfields25

# Nom du repo (par défaut: Interceptor_M)
GITHUB_REPO=Interceptor_M

# ===== SLACK (Optionnel) =====
# Webhook Slack pour les alertes
# ( Dans votre channel > Apps > Incoming Webhooks )
SLACK_WEBHOOK_URL=

# Channel Slack par défaut
SLACK_CHANNEL=#interceptor-alerts

# ===== ALERTES =====
# Seuils de temps pour les alertes (en heures)
BLOCAGE_THRESHOLD_HOURS=2
INACTIVE_THRESHOLD_HOURS=24

# ===== LOGGING =====
# Niveau de logging (DEBUG, INFO, WARNING, ERROR)
LOG_LEVEL=INFO
