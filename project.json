    "problem_resolution": {
      "detection_methods": [
        {
          "type": "KPI Alert",
          "channel": "Slack #ops-alerts",
          "detected_by": "Agent Manager"
        },
        {
          "type": "Agent Flag",
          "channel": "Slack #problem-escalation",
          "detected_by": "Any agent"
        },
        {
          "type": "Peer Review Failure",
          "channel": "Email + Slack",
          "detected_by": "Peer reviewer"
        },
        {
          "type": "Weekly Sync",
          "channel": "Weekly meeting",
          "detected_by": "Agent Manager"
        },
        {
          "type": "DG Flag",
          "channel": "Any channel",
          "detected_by": "DG"
        }
      ],
      "escalation_tree": {
        "DESIGN": {
          "contact": "D1",
