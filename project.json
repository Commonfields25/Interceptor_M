      "use_cases": [
        "Interceptor Swarm",
        "Compressed Air Launcher"
      ],
      "priority": "critical",
      "classification": "CONFIDENTIAL",
      "notes": "Zero external transmission without explicit DG validation"
    }
  ],
  "roadmap": [
    {
      "phase": 0,
      "name": "Brief Client",
      "duration_days": 1,
      "activities": [
        "Requirements gathering",
        "DG validation"
      ],
      "gate": "G0"
    },
    {
      "phase": 1,
      "name": "Concept",
      "duration_days": 7,
      "activities": [
        "3D concept explorations (D1+D2+D3)",
        "Structural screening (E1)",
        "Propulsion check (E2)",
        "Electronics review (E3)",
        "Collective debrief",
        "DG GO/NO-GO"
      ],
      "gate": "G1"
    },
    {
      "phase": 2,
      "name": "CAO Détaillée",
      "duration_days": 12,
      "activities": [
        "Detailed CAD (D1 lead)",
        "NDC + FEA iteration (E1)",
        "Propulsion specs validated (E2)",
        "Electronic schematics (E3)",
        "Payload integration (D2)",
        "CAD integrates all feedback",
        "Collective debrief",
        "DG GO/NO-GO"
      ],
      "gate": "G2"
    },
    {
      "phase": 3,
      "name": "Simulation",
      "duration_days": 9,
      "activities": [
        "Full FEA stress/fatigue/vibration (E1)",
        "Flight performance sim (E1+E2)",
        "EMI + thermal sim (E3)",
        "ML-driven topology optimization (D3)",
        "Collective debrief",
        "DG GO/NO-GO"
      ],
      "gate": "G3"
    },
    {
      "phase": 4,
      "name": "Prototype",
      "duration_days": 34,
      "activities": [
        "Prototype package preparation (D1+E1)",
        "Physical fabrication",
        "QC checks",
        "Lessons learned",
        "DG GO/NO-GO Production"
      ],
      "gate": "G4"
    },
    {
      "phase": 5,
      "name": "Production",
      "duration_days": null,
      "activities": [
        "Business case finalization",
        "Series production",
        "armasuisse delivery"
      ],
      "gate": "G5"
    }
  ],
  "workflow": {
    "handoffs": [
      {
        "id": "H1",
        "from": [
          "D1",
          "D2",
          "D3"
        ],
        "to": [
          "E1",
          "E2",
          "E3"
        ],
        "file": "BRIEF_CONCEPT_v{VER}.pdf",
        "sla_days": 1,
        "review": "Agent Manager"
      },
      {
        "id": "H2",
        "from": [
          "E1"
        ],
        "to": [
          "D1"
        ],
        "file": "NDC_STRUCT_v{VER}.xlsx",
        "sla_days": 3,
        "review": "Peer E2 check"
      },
      {
        "id": "H2b",
        "from": [
          "E2"
        ],
        "to": [
          "D1"
        ],
        "file": "SPECS_PROPULSION_v{VER}.xlsx",
        "sla_days": 3,
        "review": "E1 sign-off"
      },
      {
        "id": "H2c",
        "from": [
          "E3"
        ],
        "to": [
          "D2"
        ],
        "file": "SCHEMATIC_ELEC_v{VER}.pdf",
        "sla_days": 3,
        "review": "D2 sign-off"
      },
      {
        "id": "H3",
        "from": [
          "D1"
        ],
        "to": [
          "E1"
        ],
        "file": "CAD_REVISED_v{VER}.SLDPRT",
        "sla_days": 5,
        "review": "E1 approval"
      },
      {
        "id": "H4",
        "from": [
          "D1"
        ],
        "to": [
          "E1"
        ],
        "file": "SIM_GEOMETRY_v{VER}.SLDPRT",
        "sla_days": 5,
        "review": "E1 QC check"
      },
      {
        "id": "H5",
        "from": [
          "E1"
        ],
        "to": [
          "D1",
          "DG"
        ],
        "file": "FEA_REPORT_v{VER}.pdf",
        "sla_days": 8,
        "review": "DG review",
        "gate": "G3"
      },
      {
        "id": "H6",
        "from": [
          "D1"
        ],
        "to": [
          "E1",
          "E2",
          "E3",
          "DG"
        ],
        "file": "CAD_RELEASE_v{VER}",
        "sla_days": 10,
        "review": "DG GO required",
        "gate": "G2"
      },
      {
        "id": "H7",
        "from": [
          "D1",
          "E1",
          "E2",
          "E3"
        ],
        "to": [
          "Proto"
        ],
        "file": "PROTOTYPE_PKG_v{VER}.zip",
        "sla_days": 10,
        "review": "Agent Manager"
      }
    ],
