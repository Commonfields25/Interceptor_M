{
  "project": "Interceptor_M",
  "version": "2.0",
  "classification": "INTERNAL CONFIDENTIAL",
  "updated": "2026-06-24",
  "objective": "Développement de drones UAV multi-ligne (Civil, Industriel, Défense) avec agents IA autonomes coordinés. Cible commerciale : Europa + armasuisse.",
  "parameters": {
    "mass": {
      "total_kg": 15.5,
      "max_takeoff_kg": 24.9
    },
    "dimensions": {
      "span_mm": 1200,
      "length_mm": 950,
      "height_mm": 310
    },
    "flight": {
      "max_speed_kmh": 140,
      "cruise_speed_kmh": 72,
      "range_km": 35,
      "endurance_min": 45,
      "ceiling_m": 4000,
      "payload_kg": 1.0,
      "max_wind_kmh": 45
    },
    "propulsion": {
      "thrust_per_motor_N": 4.0,
      "motors_count": 4,
      "battery_V": 22.2,
      "esc_A": 60,
      "propeller_inches": 17
    },
    "electronics": {
      "flight_controller": "STM32H7 based",
      "gps": "Dual band RTK",
      "telemetry_freq_MHz": 915,
      "camera_4k_kg": 0.35,
      "waterproof_rating": "IP67"
    },
    "cost_targets": {
      "prototype_EUR": 15000,
      "series_production_EUR": 8000,
      "target_margin_pct": 35
    }
  },
  "products": [
