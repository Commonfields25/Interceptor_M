        "ENGINEERING": {
          "contact": "E1",
          "response_time_h": 24,
          "fallback": "E2 or E3",
          "emergency_meeting": "E1+E2+E3+DG within 48h"
        },
        "PROCESS": {
          "contact": "Agent Manager",
          "response_time_h": 24,
