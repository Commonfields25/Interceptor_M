name: IAMD Protocol Enforcer

on:
  pull_request:
    branches: [main]
    paths:
      - '**/*.md'

jobs:
  validate-headers:
    name: Validate IAMD Headers
    runs-on: ubuntu-latest
    steps:
      - name: Checkout code
        uses: actions/checkout@692973e3d937129bcbf40652eb9f2f61becf3332
        with:
          fetch-depth: 0

      - name: Set up Python
        uses: actions/setup-python@f677139bee7f93243e0b99e2f95b4e1b3c527f31
        with:
          python-version: '3.11'

      - name: Install dependencies
        run: pip install PyYAML

      - name: Get changed files
        id: changed-files
        uses: tj-actions/changed-files@84815234ad467ca051e710ca8b999c06d3d99f8e
        with:
          files: |
            **/*.md

      - name: Run IAMD Enforcer
        if: steps.changed-files.outputs.any_changed == 'true'
        run: |
          python3 scripts/iamd_enforcer.py ${{ steps.changed-files.outputs.all_changed_files }}
