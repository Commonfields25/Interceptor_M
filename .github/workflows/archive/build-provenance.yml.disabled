name: Build Provenance Attestation

on:
  push:
    branches: [main]
    tags:
      - 'v*'
  workflow_dispatch:

# REQUIRED permissions for OIDC token + attestation creation
permissions:
  id-token: write
  contents: read
  attestations: write

jobs:
  build-and-attest:
    runs-on: ubuntu-latest
    steps:
      - name: Checkout repository
        uses: actions/checkout@692973e3d937129bcbf40652eb9f2f61becf3332

      - name: Set up Python
        uses: actions/setup-python@f677139bee7f93243e0b99e2f95b4e1b3c527f31
        with:
          python-version: '3.11'

      - name: Detect build system
        id: buildsys
        run: |
          if [ -f pyproject.toml ]; then
            echo "has_build=yes" >> $GITHUB_OUTPUT
          else
            echo "has_build=no" >> $GITHUB_OUTPUT
          fi

      - name: Build Python sdist/wheel
        if: steps.buildsys.outputs.has_build == 'yes'
        run: |
          pip install build --quiet
          python -m build --sdist --no-isolation .

      - name: Package source as tarball
        if: steps.buildsys.outputs.has_build == 'no'
        run: |
          mkdir -p dist
          tar czf dist/simulation-source.tar.gz simulation/

      - name: Upload artifact
        uses: actions/upload-artifact@0b2256b8c012f0828bd1d899d584e2667d165322
        with:
          name: build-artifacts
          path: dist/

      - name: Generate build provenance attestation
        uses: actions/attest-build-provenance@520d128f1d5917a808f0292c07522e8f520ca521@520d128f1d5917a808f0292c07522e8f520ca521
        with:
          subject-path: dist/simulation-source.tar.gz

      - name: Upload attestation
        uses: actions/upload-artifact@0b2256b8c012f0828bd1d899d584e2667d165322
        with:
          name: provenance-attestation
          path: provenance.jsonl
          retention-days: 90
